{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SentinelNodeWalletReleaseApproval",
  "description": "Cryptographically bound human operator release approval record for Sentinel Node Wallet (BTCB2 / XBT). Placed on protected main to authorize Policy B candidate release qualification and deployment.",
  "type": "object",
  "required": [
    "schema_version",
    "release_target",
    "approval_metadata",
    "security_attestation"
  ],
  "additionalProperties": false,
  "properties": {
    "$comment": {
      "type": "string",
      "description": "Optional human or machine comment."
    },
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "release_target": {
      "type": "object",
      "required": [
        "target_tag",
        "approved_commit_sha",
        "bundle_version",
        "build_number"
      ],
      "additionalProperties": false,
      "properties": {
        "target_tag": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+-build[0-9]+$"
        },
        "approved_commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Full 40-character lowercase hex Git commit SHA of the reviewed and approved release candidate."
        },
        "bundle_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "build_number": {
          "type": "integer",
          "minimum": 4
        }
      }
    },
    "approval_metadata": {
      "type": "object",
      "required": [
        "approver_identity",
        "approval_policy",
        "approved_at_utc",
        "authorized_scope"
      ],
      "additionalProperties": false,
      "properties": {
        "approver_identity": {
          "type": "string",
          "minLength": 3
        },
        "approval_policy": {
          "type": "string",
          "enum": [
            "Policy B: Independent Approved Release Commit on Protected Main"
          ]
        },
        "approved_at_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "authorized_scope": {
          "type": "string",
          "enum": ["NODEPOCKET_BTCB2_ONLY"]
        },
        "review_reference": {
          "type": "string"
        }
      }
    },
    "security_attestation": {
      "type": "object",
      "required": [
        "spending_authority_disarmed",
        "authorized_spending_limit_btc",
        "restricted_rpc_methods_blocked",
        "sparkle_public_ed_key"
      ],
      "additionalProperties": false,
      "properties": {
        "spending_authority_disarmed": {
          "type": "boolean",
          "enum": [true]
        },
        "authorized_spending_limit_btc": {
          "type": "string",
          "enum": ["0.00"]
        },
        "restricted_rpc_methods_blocked": {
          "type": "integer",
          "enum": [12]
        },
        "sparkle_public_ed_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{43}=$",
          "description": "Base64-encoded 32-byte Ed25519 public verification key matching SUPublicEDKey in Info.plist."
        },
        "expected_unsigned_bundle_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Optional SHA-256 hash of the unsigned macOS application bundle."
        }
      }
    }
  }
}
